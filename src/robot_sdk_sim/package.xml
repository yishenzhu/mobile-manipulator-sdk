<?xml version="1.0"?>
<package format="3">
    <name>robot_sdk_sim</name>
    <version>0.2.0</version>
    <description>
    实现 Robot SDK 接口的模拟移动操作机器人。
    有了它，示例、集成测试和新手上手都不需要 Gazebo 或真机。
    另含一个假的关节轨迹控制器，用来验运动链路的下游。
    </description>
    <maintainer email="3464428214@qq.com">Robot SDK</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>rclcpp_action</depend>
    <depend>geometry_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>robot_state_publisher</depend>
    <depend>robot_description</depend>
    <depend>control_msgs</depend>
    <depend>trajectory_msgs</depend>
    <depend>robot_sdk_interfaces</depend>
    <depend>robot_sdk_core</depend>
    <!-- 读机器人的 URDF：关节的类型 / 限位 / 速度上限来自它。模拟器是"执行侧"，
        这些判断归它 —— SDK 只管发意图，不替机器人记一份。 -->
    <depend>urdf</depend>
    <!-- 假 move_group（move_group_mock）用的：替 moveit_adapter 的第一次检验当上游。
         它只收发 MoveGroup 的消息，不做规划。 -->
    <depend>moveit_msgs</depend>

    <test_depend>ament_cmake_gtest</test_depend>

    <!-- 只在 `rviz:=true` 时才起（launch/mock_robot.launch.py）。
         它是"看"的工具，不是模拟器的运行时依赖 —— 所以放在 exec_depend、不进 depend。 -->
    <exec_depend>rviz2</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
