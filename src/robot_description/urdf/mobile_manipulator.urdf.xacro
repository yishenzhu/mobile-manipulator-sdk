<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_manipulator">

  <!-- ============================== Properties ============================== -->
  <!-- The lidar is always present; the depth camera is optional and can be
       disabled with enable_camera:=false when its bandwidth is not needed.
       Both are rendering-based, so they need a working GPU/EGL context. -->
  <xacro:arg name="enable_camera" default="true"/>

  <!-- 硬件插件二选一：mock = 假硬件（测试用，命令即状态）；gazebo = 真仿真（gz_ros2_control）。
       ⚠️ 默认必须是 mock —— 那才是 `colcon test` 走的那条路。 -->
  <xacro:arg name="hardware" default="mock"/>
  <!-- gazebo 模式下交给 gz_ros2_control 的 gazebo 插件读的控制器配置。
       ⚠️ 默认**留空**、由 launch 传绝对路径 —— 这里写 $(find robot_description) 会在
       构建这个包自己时抛 PackageNotFoundError（那时它还不在 ament 索引里）。 -->
  <xacro:arg name="ros2_control_params" default=""/>

  <xacro:property name="PI" value="3.14159265359"/>
  <xacro:property name="base_length" value="0.42"/>
  <xacro:property name="base_width" value="0.36"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="wheel_radius" value="0.055"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_offset_x" value="0.13"/>
  <xacro:property name="wheel_offset_y" value="0.185"/>

  <xacro:property name="arm_base_height" value="0.06"/>
  <xacro:property name="upper_arm_length" value="0.22"/>
  <xacro:property name="forearm_length" value="0.20"/>
  <xacro:property name="wrist_length" value="0.06"/>
  <!-- 腕部后两个自由度各占一小段。加它们是为了把 arm 凑够 **6 个 revolute**：
       只有 4 个的时候 KDL 解不出 6 维位姿（欠自由度），只能靠 position_only_ik
       放弃姿态、只保位置。 -->
  <xacro:property name="wrist_pitch_length" value="0.03"/>
  <xacro:property name="wrist_roll_length" value="0.02"/>
  <xacro:property name="arm_radius" value="0.035"/>

  <!-- ================================ Inertia =============================== -->
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${mass * (y * y + z * z) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (x * x + z * z) / 12.0}" iyz="0.0"
               izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}" iyz="0.0"
               izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================== Base =================================== -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.35 0.37 0.40 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="12.0" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- ============================== Wheels ================================= -->
  <xacro:macro name="wheel" params="prefix y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.6" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_offset_x} ${y} ${-base_height / 2.0}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" y="${wheel_offset_y}"/>
  <xacro:wheel prefix="right" y="${-wheel_offset_y}"/>

  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${-wheel_offset_x - 0.02} 0 ${-base_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <!-- ============================== Sensors ================================ -->
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="dark_blue">
        <color rgba="0.1 0.2 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.15" radius="0.04" length="0.04"/>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <!-- Front-top corner: as far from the arm as the base allows, so the scan
         sees as little of the robot's own body as possible. -->
    <origin xyz="${base_length / 2.0 - 0.05} 0 ${base_height / 2.0 + 0.045}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.09 0.03"/>
      </geometry>
      <material name="dark_blue">
        <color rgba="0.1 0.2 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.09 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.08" x="0.03" y="0.09" z="0.03"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_length / 2.0 - 0.01} 0 ${base_height / 2.0 + 0.05}" rpy="0 0 0"/>
  </joint>

  <!-- =============================== Arm =================================== -->
  <link name="arm_base_link">
    <visual>
      <geometry>
        <cylinder radius="0.055" length="${arm_base_height}"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.45 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.055" length="${arm_base_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.6" radius="0.055" length="${arm_base_height}"/>
  </link>
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="-0.05 0 ${base_height / 2.0 + arm_base_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <cylinder radius="${arm_radius}" length="0.06"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.45 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${arm_radius}" length="0.06"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.4" radius="${arm_radius}" length="0.06"/>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 ${arm_base_height / 2.0 + 0.03}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="30.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 ${upper_arm_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_radius}" length="${upper_arm_length}"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.45 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${upper_arm_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_radius}" length="${upper_arm_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.9" radius="${arm_radius}" length="${upper_arm_length}"/>
  </link>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="30.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 ${forearm_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_radius * 0.9}" length="${forearm_length}"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.45 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${forearm_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_radius * 0.9}" length="${forearm_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.7" radius="${arm_radius * 0.9}" length="${forearm_length}"/>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 ${upper_arm_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="20.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 ${wrist_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_radius * 0.8}" length="${wrist_length}"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.45 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${wrist_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_radius * 0.8}" length="${wrist_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.3" radius="${arm_radius * 0.8}" length="${wrist_length}"/>
  </link>
  <joint name="wrist_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 ${forearm_length}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- 腕部第 2、3 段：Z-Y-Z 球形腕，和 pan/lift/elbow 一起构成 6R。
       ⚠️ 第 3 段轴必须是 Z：夹爪沿 +Z 装在这个法兰上，绕工具轴自转就是绕 Z。
       ⚠️ pitch = 0 时第 1、3 段共线，是 Z-Y-Z 固有的奇异位形，不是建模错误。 -->
  <link name="wrist_pitch_link">
    <visual>
      <origin xyz="0 0 ${wrist_pitch_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_radius * 0.7}" length="${wrist_pitch_length}"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.45 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${wrist_pitch_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_radius * 0.7}" length="${wrist_pitch_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.2" radius="${arm_radius * 0.7}"
                              length="${wrist_pitch_length}"/>
  </link>
  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="wrist_pitch_link"/>
    <origin xyz="0 0 ${wrist_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.6" upper="1.6" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="wrist_roll_link">
    <visual>
      <origin xyz="0 0 ${wrist_roll_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_radius * 0.6}" length="${wrist_roll_length}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.35 0.37 0.40 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${wrist_roll_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${arm_radius * 0.6}" length="${wrist_roll_length}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.15" radius="${arm_radius * 0.6}"
                              length="${wrist_roll_length}"/>
  </link>
  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_pitch_link"/>
    <child link="wrist_roll_link"/>
    <origin xyz="0 0 ${wrist_pitch_length}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5.0" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <!-- ============================== Gripper ================================ -->
  <link name="gripper_base_link">
    <visual>
      <geometry>
        <box size="0.05 0.06 0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.06 0.02"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.2" x="0.05" y="0.06" z="0.02"/>
  </link>
  <joint name="gripper_base_joint" type="fixed">
    <parent link="wrist_roll_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 ${wrist_roll_length + 0.01}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="finger" params="prefix y">
    <link name="${prefix}_finger_link">
      <visual>
        <origin xyz="0 ${y} 0.02" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.012 0.04"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 ${y} 0.02" rpy="0 0 0"/>
        <geometry>
          <box size="0.01 0.012 0.04"/>
        </geometry>
      </collision>
      <xacro:box_inertial mass="0.05" x="0.01" y="0.012" z="0.04"/>
    </link>
  </xacro:macro>

  <xacro:finger prefix="left" y="0.0"/>
  <xacro:finger prefix="right" y="0.0"/>

  <!-- A single prismatic command drives both fingers in opposite directions. -->
  <joint name="gripper_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0 0.01 0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" effort="20.0" velocity="0.1"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
  <joint name="gripper_right_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0 -0.01 0.01" rpy="0 0 0"/>
  </joint>

  <!-- ============================== Gazebo ================================= -->
  <xacro:macro name="arm_position_controller" params="joint">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <topic>/arm/${joint}/cmd_pos</topic>
        <p_gain>25.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>2.0</d_gain>
      </plugin>
    </gazebo>
  </xacro:macro>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2.0 * wheel_offset_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <!-- ⚠️ gazebo 模式下由 ros2_control 的 joint_state_broadcaster 发 /joint_states，
         这里不能再发一份 —— 两个源发同一批关节会打架。 -->
    <xacro:unless value="${'$(arg hardware)' == 'gazebo'}">
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
        <joint_name>shoulder_pan_joint</joint_name>
        <joint_name>shoulder_lift_joint</joint_name>
        <joint_name>elbow_joint</joint_name>
        <joint_name>wrist_joint</joint_name>
        <joint_name>wrist_pitch_joint</joint_name>
        <joint_name>wrist_roll_joint</joint_name>
        <joint_name>gripper_joint</joint_name>
      </plugin>
    </xacro:unless>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>

  <!-- Both the lidar and the depth camera are rendering-based, so the Sensors
       system always needs a rendering context. enable_camera only controls
       whether the depth camera sensor is spawned. -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- ⚠️ 这些 gz 关节位置控制器只在 mock 模式下保留；gazebo 模式下手臂归 ros2_control，
       两份一起放进 Gazebo 会**抢同一个关节**。 -->
  <xacro:unless value="${'$(arg hardware)' == 'gazebo'}">
    <xacro:arm_position_controller joint="shoulder_pan_joint"/>
    <xacro:arm_position_controller joint="shoulder_lift_joint"/>
    <xacro:arm_position_controller joint="elbow_joint"/>
    <xacro:arm_position_controller joint="wrist_joint"/>
    <xacro:arm_position_controller joint="wrist_pitch_joint"/>
    <xacro:arm_position_controller joint="wrist_roll_joint"/>
    <xacro:arm_position_controller joint="gripper_joint"/>
  </xacro:unless>

  <!-- gazebo 模式：这个 gz 插件自己会把 controller_manager 建起来（不用另起 ros2_control_node）。 -->
  <xacro:if value="${'$(arg hardware)' == 'gazebo'}">
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg ros2_control_params)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <!-- Override Gazebo's scoped frame name so the message frame matches the
           URDF/TF frame published by robot_state_publisher. -->
      <gz_frame_id>laser_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg enable_camera)">
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <topic>/camera/depth</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>64</width>
          <height>48</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  </xacro:if>
  <!-- ============================ ros2_control ============================= -->
  <!-- 给 ros2_control 用的：声明关节、接口、硬件插件，只声明要控的 7 个（车轮没人控）。
       ⚠️ 插件由 `hardware` 参数二选一 —— 默认 mock（假硬件，命令即状态，不需要 Gazebo）；
       gazebo 模式换成 gz_ros2_control，那时 MoveIt 才能**真的**驱动仿真里的机器人。 -->
  <ros2_control name="mobile_manipulator" type="system">
    <hardware>
      <xacro:if value="${'$(arg hardware)' == 'gazebo'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="${'$(arg hardware)' == 'gazebo'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:unless>
    </hardware>
    <joint name="shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wrist_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wrist_pitch_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="wrist_roll_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="gripper_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

</robot>
