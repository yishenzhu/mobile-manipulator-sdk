<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="sdk_demo">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- 传感器系统归世界（全局管理器，一个实例统管全部传感器）；放两处会各发一遍、频率翻倍。 -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.57 0.6 1</ambient>
            <diffuse>0.55 0.57 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ⚠️ 房间尺寸必须和 mock 机器人一致（x ±5、y ±4）——
         因为 Nav2 用的 maps/room.pgm 就是照 mock 的常量生成的；对不上就会照着错地图撞墙。 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.3 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.3 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.75 0.38 0.18 1</ambient>
            <diffuse>0.75 0.38 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.3 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.3 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.75 0.38 0.18 1</ambient>
            <diffuse>0.75 0.38 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 8.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8.0 1.0</size></box></geometry>
          <material>
            <ambient>0.75 0.38 0.18 1</ambient>
            <diffuse>0.75 0.38 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 8.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8.0 1.0</size></box></geometry>
          <material>
            <ambient>0.75 0.38 0.18 1</ambient>
            <diffuse>0.75 0.38 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 一根柱子：给感知和规划一点真东西可绕。 -->
    <model name="pillar">
      <static>true</static>
      <pose>1.0 0.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.35 0.7 1</ambient>
            <diffuse>0.15 0.35 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
