<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_sdk_tests</name>
  <version>0.4.0</version>
  <description>
    跨包的验收探针：验的是**行为**（忙时拒收、取消、折角、避障预检、加速度生效），
    不是单个函数 —— 那些在 robot_sdk_core 的单元测试里。
    放在仓库里的意义是**可复核**：谁都能跑一遍，不用再靠临时写一段。
  </description>
  <maintainer email="3464428214@qq.com">Robot SDK</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- 这个包**整包只有测试**：模块是探针（`check()`），fixture 负责把被验的东西起起来。
       所以下面这些都是 test_depend —— 它们不该出现在"部署这个包"的依赖里。
       唯一的例外见最后两行。 -->
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>control_msgs</test_depend>
  <test_depend>trajectory_msgs</test_depend>
  <test_depend>tf2_ros</test_depend>
  <!-- 导航那条 fixture 靠它问 bt_navigator 的生命周期状态 —— 那才是"整栈能干活"的判据
       （代价地图的帧是 latch 的，有帧 ≠ 就绪，实测踩过）。 -->
  <test_depend>lifecycle_msgs</test_depend>
  <!-- 笛卡尔那条探针要读适配器发下去的 MoveGroup 目标（moveit_msgs）。 -->
  <test_depend>moveit_msgs</test_depend>
  <test_depend>robot_sdk_interfaces</test_depend>
  <!-- 被验的东西，由 fixture 起起来。注意探针**不走 SDK** ——
       用的是裸 action 接口（robot_sdk_interfaces），这样看机器人侧的行为更直接；
       "SDK 用起来对不对"由 robot_sdk_examples 那三个 C++ 示例负责。 -->
  <test_depend>robot_sdk_sim</test_depend>
  <test_depend>robot_sdk_bridge</test_depend>
  <!-- 被验的整栈：navigation.launch.py 来自它。 -->
  <test_depend>robot_sdk_nav2</test_depend>
  <!-- mock 的关节限位来自这份 URDF（fixture 把路径喂给它）。
       ⚠️ 必须**声明**依赖：colcon test 只把声明过的依赖放进测试环境，
       少了这一条 conftest 一导入就 PackageNotFoundError（实测踩过）。 -->
  <test_depend>robot_description</test_depend>

  <!-- 真栈那条路（test_real_stack.py）要的：fixture 会起 ros2_control 和 move_group。
       ⚠️ 同样必须逐条声明 —— 少一条，colcon test 的环境里就少一个包。 -->
  <test_depend>ros2_control</test_depend>
  <test_depend>controller_manager</test_depend>
  <!-- fixture 的就绪判据要问控制器状态（问真状态，不是看话题在不在发）。 -->
  <test_depend>controller_manager_msgs</test_depend>
  <test_depend>joint_state_broadcaster</test_depend>
  <test_depend>joint_trajectory_controller</test_depend>
  <!-- move_group.launch.py 会 import 它。 -->
  <test_depend>moveit_configs_utils</test_depend>
  <test_depend>moveit_ros_move_group</test_depend>
  <!-- 真栈那条探针要查 TF（结果里的最终误差就是从那上面量的）。 -->
  <test_depend>tf2_ros</test_depend>

  <!-- 探针的本体是 check()（不符合预期就 assert），test/ 里把它们当 pytest 跑。
       起不来 = error，判据不对 = failure —— colcon test-result 里天生分开。 -->
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_index_python</test_depend>

  <!-- ⚠️ 这两个留在 exec：本包**装了**一个 launch 文件（motion_chain.launch.py），
       装出来的东西得能 `ros2 launch` 起来 —— 那是运行期依赖，不是测试依赖。 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
