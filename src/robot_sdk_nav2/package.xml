<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>robot_sdk_nav2</name>
    <version>0.1.0</version>
    <description>
    把 Nav2 接到 SDK 契约上的部署配置：被控对象是 mock 机器人，
    中间由 robot_sdk_bridge 翻译。不需要 Gazebo、地图和里程计话题。
    </description>
    <maintainer email="3464428214@qq.com">Robot SDK</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>robot_sdk_sim</exec_depend>
    <exec_depend>robot_sdk_bridge</exec_depend>
    <exec_depend>nav2_planner</exec_depend>
    <exec_depend>nav2_controller</exec_depend>
    <exec_depend>nav2_behaviors</exec_depend>
    <exec_depend>nav2_bt_navigator</exec_depend>
    <exec_depend>nav2_lifecycle_manager</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
