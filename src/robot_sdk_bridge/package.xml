<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>robot_sdk_bridge</name>
    <version>0.2.0</version>
    <description>
    适配层：把 SDK 的动作翻译到具体的下游后端上，客户代码不依赖 nav2_msgs / control_msgs。
    目前提供导航（SDK → Nav2）与运动（SDK → FollowJointTrajectory）。
    </description>
    <maintainer email="3464428214@qq.com">Robot SDK</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>rclcpp_action</depend>
    <depend>nav2_msgs</depend>
    <depend>control_msgs</depend>
    <!-- moveit_adapter（SDK 笛卡尔目标 → MoveIt 的 MoveGroup）用到的。
         客户代码不依赖它们 —— 这正是"适配层"存在的原因。 -->
    <depend>moveit_msgs</depend>
    <depend>shape_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>sensor_msgs</depend>
    <depend>robot_sdk_interfaces</depend>
    <!-- 为 robot_sdk/detail/action_slot.hpp（动作服务端的通用槽位） -->
    <depend>robot_sdk_core</depend>

    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
