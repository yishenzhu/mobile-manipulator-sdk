<?xml version="1.0"?>
<package format="3">
  <name>robot_sdk_mcp</name>
  <version>0.1.0</version>
  <description>
    把 Robot SDK 的导航 / 运动 / 感知 / 状态四类能力暴露成 MCP 工具，供 Agent 驱动。
    只做翻译，不做审批 / 重试 / 并发策略。
  </description>
  <maintainer email="3464428214@qq.com">Robot SDK</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <!-- robot_sdk 模块，由 source install/setup.bash 进入 PYTHONPATH。 -->
  <exec_depend>robot_sdk_py</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
